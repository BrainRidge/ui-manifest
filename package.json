    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-json-schema-generator": "^2.3.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.0"
  }
}
