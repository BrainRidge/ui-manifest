{
  "name": "ui-manifest-monorepo",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
