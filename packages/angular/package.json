{
  "name": "@ui-manifest-json/angular",
  "version": "0.3.0",
  "description": "Extract a diffable JSON manifest of routes, components and template trees from an Angular app's source.",
  "keywords": [
    "angular",
    "ui-manifest",
    "routes",
    "components",
    "template",
    "static-analysis",
    "diff"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrainRidge/ui-manifest.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/BrainRidge/ui-manifest/tree/main/packages/angular#readme",
  "bugs": {
    "url": "https://github.com/BrainRidge/ui-manifest/issues"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ui-manifest-angular": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@ui-manifest-json/core": "^0.3.0"
  },
  "peerDependencies": {
    "typescript": ">=4.8.0 <6.0.0",
    "@angular/compiler": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/compiler": "^22.1.5",
    "typescript": "^5.5.0"
  }
}
