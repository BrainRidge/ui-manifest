{
  "name": "@ui-manifest-json/react",
  "version": "0.3.1",
  "description": "Extract a diffable JSON manifest of routes, components and JSX trees from a React app's source.",
  "keywords": [
    "react",
    "react-router",
    "ui-manifest",
    "routes",
    "components",
    "jsx",
    "static-analysis",
    "diff"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrainRidge/ui-manifest.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/BrainRidge/ui-manifest/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/BrainRidge/ui-manifest/issues"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ui-manifest-react": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@ui-manifest-json/core": "^0.3.1"
  },
  "peerDependencies": {
    "typescript": ">=4.8.0 <6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}
